# 前端默认使用同源 API：/api/auth/login、/api/auth/register、/api/auth/me、/api/pay/create。
# 如果登录或支付服务单独部署，再覆盖下面的 VITE_* 地址。

# 外部登录系统入口。前端会附带 returnTo 参数；如果使用站内登录页，保持为空。
VITE_AUTH_LOGIN_URL=

# 退出登录入口，可选。前端会附带 returnTo 参数。
VITE_AUTH_LOGOUT_URL=

# 站内登录 / 注册 API，可返回 { token, user }。
VITE_AUTH_LOGIN_API_URL=
VITE_AUTH_REGISTER_API_URL=

# 会员状态接口，需通过 Cookie 或 Bearer Token 识别当前用户。
VITE_MEMBERSHIP_API_URL=

# 后端创建 ZPAY 支付订单接口，需由后端完成订单创建、ZPAY 签名和回调验签。
VITE_ZPAY_CHECKOUT_API_URL=

# 以下变量只配置在 Sealos 服务端环境中，不能暴露给 VitePress 前端。
# AUTH_SECRET 生产环境必须改成随机长字符串；SITE_URL 必须包含 https://。
AUTH_SECRET=change-me-to-a-long-random-secret
SITE_URL=https://your-sealos-domain.example.com
DATA_DIR=/data
ZPAY_PID=
ZPAY_KEY=
ZPAY_API=https://zpayz.cn/submit.php
ZPAY_MOCK=
